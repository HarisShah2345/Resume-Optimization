ANTHROPIC_API_KEY=<enter your api key here>
# C drive is full on this machine — keep all regenerable artifacts on D.
# Optional: override temp/output directory (defaults to C:\Users\<you>\.resume-optimizer).
# TEMP_DIR=D:\n8n Workflows\Resume-Optimizer\.runtime\tmp
# Optional: where Playwright looks for browsers (keep off the full C drive).
# PLAYWRIGHT_BROWSERS_PATH=D:\n8n Workflows\Resume-Optimizer\.playwright-browsers
